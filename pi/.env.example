GEMINI_API_KEY=your_key_here

# ALSA audio output device. Run `aplay -l` to list available cards.
# Use "default" for the system default, or e.g. "plughw:CARD=Device,DEV=0" for USB audio.
#   I was seeing `Subdevice #0: subdevice #0 card 1: Headphones [bcm2835 Headphones], device 0: bcm2835 Headphones [bcm2835 Headphones]` in `aplay -l` output, so I set this to "plughw:CARD=Headphones,DEV=0" for my USB audio adapter.
#   Note: `Headphones` replaced `Device` in the string `plughw:CARD=Device,DEV=0`.
#   Final value: `ALSA_DEVICE=plughw:CARD=Headphones,DEV=0`
ALSA_DEVICE=default
